FROM kalilinux/kali-rolling:latest

# Modern Kali uses DEB822 format at /etc/apt/sources.list.d/kali.sources
# Overwrite it with a working HTTP mirror (HTTPS fails: stale CA certs in base image)
RUN printf 'Types: deb\nURIs: http://kali.mirror.garr.it/kali/\nSuites: kali-rolling\nComponents: main contrib non-free non-free-firmware\nSigned-By: /usr/share/keyrings/kali-archive-keyring.gpg\n' > /etc/apt/sources.list.d/kali.sources \
 && rm -f /etc/apt/sources.list \
 && apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates hydra nmap openssh-client iputils-ping netcat-openbsd \
 && rm -rf /var/lib/apt/lists/*

CMD ["sleep", "infinity"]
RUN apt-get update && apt-get install -y --no-install-recommends expect sshpass && rm -rf /var/lib/apt/lists/*
