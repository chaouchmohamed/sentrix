# Copy to .env and fill in. Never commit .env.
SENTRIX_DB_PATH=data/sentrix.db
SENTRIX_CONFIG=config/sentrix.yaml
COWRIE_LOG=honeypot/logs/cowrie.json
DASHBOARD_PORT=8501

# React dashboard + read-only API
API_PORT=8000
# Leave VITE_API_BASE unset to use the same-origin /api path (Vite proxies it in dev).
# VITE_API_BASE=/api
# SENTRIX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
